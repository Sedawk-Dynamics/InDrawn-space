# SMTP configuration for /api/send-enquiry
# Copy this file to .env.local and fill in real values.

# Required
SMTP_HOST=smtp.example.com
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
FROM_EMAIL=info@indawn.in

# Optional
# Port defaults to 587 (STARTTLS) if omitted
SMTP_PORT=587
# Where enquiry emails are delivered; falls back to FROM_EMAIL if omitted
BUSINESS_EMAIL=info@indawn.in
